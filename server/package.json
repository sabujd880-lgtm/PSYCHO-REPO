  "type": "module",
  "description": "Backend foundation for Personal Psychology Knowledge & Intelligence Platform",
  "main": "src/server.ts",
  "scripts": {
    "dev": "node --experimental-strip-types src/server.ts",
    "build": "tsc",
    "start": "node --experimental-strip-types src/server.ts",
